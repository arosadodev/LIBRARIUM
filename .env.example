# Plantilla para docker-compose.prod.yml. Copiar a .env (no versionar) y
# sustituir los valores con secretos generados, por ejemplo:
# openssl rand -hex 32       (contraseñas MySQL)
# openssl rand -base64 48    (clave JWT)
MYSQL_USER=librarium
MYSQL_PASSWORD=GENERAR_UNA_CONTRASENA_NUEVA_ALEATORIA
MYSQL_ROOT_PASSWORD=GENERAR_OTRA_CONTRASENA_NUEVA_ALEATORIA
LIBRARIUM_JWT_SECRET=GENERAR_UNA_CLAVE_BASE64_NUEVA

# Para ejecutar la API directamente contra MySQL local (localhost:3308),
# configura también estas variables con la cuenta que exista en esa instancia.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3308/librarium_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=CAMBIAR_POR_EL_USUARIO_MYSQL_LOCAL
SPRING_DATASOURCE_PASSWORD=CAMBIAR_POR_LA_CONTRASENA_MYSQL_LOCAL
