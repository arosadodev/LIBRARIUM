# Clave Base64 de 32 bytes o más para firmar los JWT.
# Generar con: openssl rand -base64 32
LIBRARIUM_JWT_SECRET=REEMPLAZAR_CON_UNA_CLAVE_BASE64_DE_AL_MENOS_32_BYTES

# Credenciales del MySQL local (localhost:3308).
# Si el volumen de MySQL ya existía, usa la contraseña con la que se inicializó.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3308/librarium_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=REEMPLAZAR_CON_LA_CONTRASENA_CONFIGURADA_EN_MYSQL
